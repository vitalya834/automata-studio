{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://automata.studio/schema/automata-test-plan-v1.schema.json",
  "title": "Automata Studio Test Plan IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "modelId", "metadata", "cases"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "$ref": "#/$defs/nonEmptyString" },
    "name": { "$ref": "#/$defs/nonEmptyString" },
    "modelId": { "$ref": "#/$defs/nonEmptyString" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "cases": {
      "type": "array",
      "items": { "$ref": "#/$defs/testCase" }
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null", "array", "object"]
      }
    },
    "outputSymbol": {
      "type": ["string", "null"]
    },
    "testStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "allowedExpectedOutputs", "timeoutMs"],
      "properties": {
        "input": { "$ref": "#/$defs/nonEmptyString" },
        "allowedExpectedOutputs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/outputSymbol" }
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "metadata": { "$ref": "#/$defs/metadata" }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "metadata", "steps"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "metadata": { "$ref": "#/$defs/metadata" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/testStep" }
        }
      }
    }
  }
}
