{
  "host": "127.0.0.1",
  "port": 1502,
  "unitId": 1,
  "allowWrites": false,
  "connectTimeoutMs": 2000,
  "responseTimeoutMs": 2000,
  "inputs": {
    "read_lamp": {
      "operation": {
        "kind": "readCoils",
        "address": 10,
        "quantity": 1
      },
      "outputs": [
        {
          "symbol": "lamp_on",
          "when": { "kind": "valueAt", "index": 0, "equals": 1 }
        }
      ],
      "otherwise": "lamp_off"
    }
  }
}
