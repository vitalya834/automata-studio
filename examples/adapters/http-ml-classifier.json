{
  "baseUrl": "http://127.0.0.1:8080",
  "maxResponseBytes": 1048576,
  "inputs": {
    "predict_positive": {
      "method": "POST",
      "path": "/v1/predict",
      "headers": { "accept": "application/json" },
      "body": { "features": [0.9, 0.8, 0.7] },
      "output": { "kind": "json-pointer", "pointer": "/prediction/label" }
    },
    "predict_negative": {
      "method": "POST",
      "path": "/v1/predict",
      "headers": { "accept": "application/json" },
      "body": { "features": [0.1, 0.2, 0.0] },
      "output": { "kind": "json-pointer", "pointer": "/prediction/label" }
    }
  }
}
