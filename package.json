{
  "name": "automata-studio",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "cli:build": "vite build --ssr src/runner-cli.ts --outDir dist-cli",
    "cli": "npm run cli:build --silent && node dist-cli/runner-cli.js",
    "demo:cli": "npm run cli -- run examples/test-plans/turnstile-transition-cover.json --adapter cli --executable node --arg test-fixtures/cli-sut/turnstile.cjs",
    "test": "vitest run",
    "cpp:build": "powershell -ExecutionPolicy Bypass -File scripts/build-cpp.ps1",
    "cpp:test": "powershell -ExecutionPolicy Bypass -File scripts/build-cpp.ps1 -Test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
